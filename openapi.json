{
  "openapi": "3.0.0",
  "info": {
    "title": "Urja Meter Ops API",
    "description": "API wrapper for Urja Meter Ops portal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/meters": {
      "get": {
        "summary": "List all meters",
        "operationId": "listMeters",
        "tags": ["Meters"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-indexed)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Records per page",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of meters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "meters": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MeterSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/meters/{meterId}": {
      "get": {
        "summary": "Get meter details",
        "operationId": "getMeter",
        "tags": ["Meters"],
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "summary": "Get network hierarchy",
        "operationId": "getNetwork",
        "tags": ["Network"],
        "responses": {
          "200": {
            "description": "Network hierarchy tree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hierarchy": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NetworkNode"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MeterSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"]
          },
          "last_read": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "name", "region", "status"]
      },
      "MeterDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "specs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "consumption_24h": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hour": {
                  "type": "string"
                },
                "kwh": {
                  "type": "number"
                }
              }
            }
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "specs", "consumption_24h"]
      },
      "NetworkNode": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["region", "district", "pole", "meter"]
          },
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetworkNode"
            }
          }
        },
        "required": ["type", "name", "children"]
      }
    }
  }
}
